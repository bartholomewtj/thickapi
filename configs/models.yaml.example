# Catalogue policy (SPEC 10.3): one row per vendor model family, the newest version only.
# `thickapi models check` compares every row with the vendor's live list and fails when a
# family has a newer version or a wire id is gone. Bump `cli_model` / `vendor_model`, keep
# the row id, re-run `sync-pi`.
aliases:
  fable: subs/claude/fable
  opus: subs/claude/opus
  sonnet: subs/claude/sonnet
  grok-4.7: subs/grok/grok-4.7
  flash: subs/agy/gemini-3.8-flash
  argon: subs/agy/gemini-4-argon
  agy-opus: subs/agy/opus
  cursor-fable: subs/cursor/fable
  grok-4.7-high: subs/cursor/grok-4.7
  cursor-grok-4.7: subs/cursor/grok-4.7
  cursor-grok-4.7-high: subs/cursor/grok-4.7
  cursor-auto: subs/cursor/auto
  composer: subs/cursor/composer-2.5
  composer-2.5: subs/cursor/composer-2.5
  sol: subs/codex/gpt-sol
  astra: subs/codex/gpt-astra
  luna: subs/codex/gpt-luna

models:
  # Claude (Claude Code subscription): OAuth-direct, bridge fallback when blocked (SPEC 19.15).
  - id: subs/claude/fable
    backend: claude_code
    cli_model: claude-fable-5-1
    context_window: 200000
    max_tokens: 32000
    thinking: true
    input: [text, image]
    cost: 0
    name: "Claude Fable 5.1 (subscription)"
    # Thin surface (SPEC 19.2): OAuth-direct, bridge fallback when blocked. Omit = cli_turn (thick only).
    transport: oauth_direct
  - id: subs/claude/opus
    backend: claude_code
    cli_model: claude-opus-5-5
    context_window: 200000
    max_tokens: 32000
    thinking: true
    input: [text, image]
    cost: 0
    name: "Claude Opus 5.5 (subscription)"
    transport: oauth_direct
  - id: subs/claude/sonnet
    backend: claude_code
    cli_model: claude-sonnet-5-5
    context_window: 1000000
    max_tokens: 128000
    thinking: true
    input: [text, image]
    cost: 0
    name: "Claude Sonnet 5.5 (subscription)"
    transport: oauth_direct
  # Grok (grok CLI subscription): grok-4.7, 500k window.
  - id: subs/grok/grok-4.7
    backend: grok
    cli_model: grok-4.7
    context_window: 500000
    max_tokens: 32000
    thinking: true
    cost: 0
    name: "Grok 4.7 (subscription)"
    transport: oauth_direct
  # Antigravity: cli_model is the agy CLI model id (thick lane); vendor_model is the Code Assist
  # catalogue id the thin adapter sends, with the effort level from Pi's /thinking.
  - id: subs/agy/gemini-3.8-flash
    backend: agy
    cli_model: gemini-3.8-flash
    vendor_model: gemini-3.8-flash-tiered
    context_window: 1000000
    max_tokens: 65536
    thinking: true
    input: [text, image]
    cost: 0
    name: "Gemini 3.8 Flash (agy subscription)"
    transport: oauth_direct
  # Gemini 4 Argon and Claude Opus 5.5 are one backend id per level (`-low|-medium|-high`);
  # vendor_model names the default level and the thin adapter swaps the suffix for the
  # requested one. Argon is only served to the 1.4.7 CLI User-Agent (SPEC 19.8).
  - id: subs/agy/gemini-4-argon
    backend: agy
    cli_model: gemini-4-argon-medium
    vendor_model: gemini-4-argon-medium
    context_window: 1048576
    max_tokens: 65536
    thinking: true
    input: [text, image]
    cost: 0
    name: "Gemini 4 Argon (agy subscription)"
    transport: oauth_direct
  - id: subs/agy/opus
    backend: agy
    cli_model: claude-opus-5-5-medium
    vendor_model: claude-opus-5-5-medium
    context_window: 1000000
    max_tokens: 128000
    thinking: true
    input: [text, image]
    cost: 0
    name: "Claude Opus 5.5 (agy subscription)"
    transport: oauth_direct
  # Cursor thin rows go over the agent service (SPEC 19.8, T4). The wire id carries the effort
  # as a suffix where the model has one (claude-fable-5-1-thinking-high, grok-4.7-high).
  # Grok 4.7's printed slug decomposes to reasoning_effort + fast, not `effort`.
  # context_window 500000 on the Grok row sends context=500k (max mode). 256k is the
  # slug's first variant, used only when a caller does not pass a context tier.
  # auto has no effort suffix, so the level is ignored. `enabled: false` is
  # the kill switch when Cursor moves the client-version floor (HTTP 464 -> vendor_drift).
  - id: subs/cursor/fable
    backend: cursor
    cli_model: claude-fable-5-1-thinking-high
    vendor_model: claude-fable-5-1-thinking-high
    context_window: 300000
    max_tokens: 32000
    thinking: true
    input: [text, image]
    cost: 0
    name: "Claude Fable 5.1 (Cursor subscription)"
    transport: oauth_direct
  - id: subs/cursor/grok-4.7
    backend: cursor
    cli_model: grok-4.7-high
    vendor_model: grok-4.7-high
    context_window: 500000
    max_tokens: 32000
    thinking: true
    input: [text]
    cost: 0
    name: "Grok 4.7 (Cursor subscription)"
    transport: oauth_direct
  - id: subs/cursor/auto
    backend: cursor
    cli_model: auto
    vendor_model: auto
    context_window: 128000
    max_tokens: 32000
    thinking: false
    input: [text, image]
    cost: 0
    name: "Auto (Cursor subscription)"
    transport: oauth_direct
  # Composer 2.5 is its own family (models check: composer / 2.5). No effort suffix, so
  # the level is ignored the same way auto's is. composer-2.5-fast is the fast variant
  # of this same version, not a newer one.
  - id: subs/cursor/composer-2.5
    backend: cursor
    cli_model: composer-2.5
    vendor_model: composer-2.5
    context_window: 200000
    max_tokens: 32000
    thinking: false
    input: [text, image]
    cost: 0
    name: "Composer 2.5 (Cursor subscription)"
    transport: oauth_direct
  # Codex (ChatGPT plan, the codex CLI's login): the Responses API at chatgpt.com (SPEC 19.8).
  # context_window is the model's window at the CLI's 95% effective share. Effort travels as
  # reasoning.effort; only Luna takes `none` (Pi `off`), none of them `minimal`.
  - id: subs/codex/gpt-sol
    backend: codex
    cli_model: gpt-6.1-sol
    context_window: 475000
    max_tokens: 128000
    thinking: true
    input: [text, image]
    cost: 0
    name: "GPT-6.1-Sol (Codex subscription)"
    transport: oauth_direct
  - id: subs/codex/gpt-astra
    backend: codex
    cli_model: gpt-6-astra
    context_window: 258400
    max_tokens: 128000
    thinking: true
    input: [text, image]
    cost: 0
    name: "GPT-6-Astra (Codex subscription)"
    transport: oauth_direct
  - id: subs/codex/gpt-luna
    backend: codex
    cli_model: gpt-6-luna
    context_window: 258400
    max_tokens: 128000
    thinking: true
    input: [text, image]
    cost: 0
    name: "GPT-6-Luna (Codex subscription)"
    transport: oauth_direct
  # Paid fallback for combos (thick lane only, SPEC 6.5): the OpenRouter id of the newest Opus.
  - id: or/anthropic/claude-opus-5
    backend: pi
    provider: openrouter
    cli_model: anthropic/claude-opus-5
