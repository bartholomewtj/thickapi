{
  "method": "POST",
  "url": "https://daily-cloudcode-pa.googleapis.com/v1internal:streamGenerateContent?alt=sse",
  "headers": [
    [
      "accept",
      "text/event-stream"
    ],
    [
      "authorization",
      "<redacted>"
    ],
    [
      "content-type",
      "application/json"
    ],
    [
      "user-agent",
      "antigravity/1.2.4 windows/amd64"
    ],
    [
      "x-goog-api-client",
      "google-cloud-sdk vscode_cloudshelleditor/0.1"
    ],
    [
      "client-metadata",
      "{\"ideType\":\"ANTIGRAVITY\",\"platform\":\"WINDOWS\",\"pluginType\":\"GEMINI\"}"
    ]
  ],
  "body": {
    "model": "gemini-3.8-flash-tiered",
    "project": "aicode-consumers",
    "request": {
      "contents": [
        {
          "parts": [
            {
              "text": "Read the file notes.txt with the read_file tool and tell me its first line. Do not guess its contents."
            }
          ],
          "role": "user"
        }
      ],
      "generationConfig": {
        "maxOutputTokens": 512,
        "thinkingConfig": {
          "includeThoughts": true,
          "thinkingLevel": "low"
        }
      },
      "systemInstruction": {
        "parts": [
          {
            "text": "You are a terse assistant under test. When a tool fits the task, call it instead of answering in prose."
          }
        ]
      },
      "tools": [
        {
          "functionDeclarations": [
            {
              "description": "Read a UTF-8 text file and return its contents.",
              "name": "read_file",
              "parameters": {
                "properties": {
                  "path": {
                    "description": "Path to the file, relative to the workspace.",
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              }
            }
          ]
        }
      ]
    },
    "requestId": "agent-capture-tool-<UUID-2>",
    "requestType": "agent",
    "userAgent": "antigravity"
  }
}