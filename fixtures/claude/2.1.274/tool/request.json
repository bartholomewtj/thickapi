{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": [
    [
      "authorization",
      "<redacted>"
    ],
    [
      "anthropic-version",
      "2023-06-01"
    ],
    [
      "anthropic-beta",
      "claude-code-20250219,oauth-2025-04-20,interleaved-thinking-2025-05-14"
    ],
    [
      "user-agent",
      "claude-cli/2.1.274 (external, cli)"
    ],
    [
      "x-app",
      "cli"
    ],
    [
      "accept",
      "text/event-stream"
    ],
    [
      "content-type",
      "application/json"
    ]
  ],
  "body": {
    "max_tokens": 5024,
    "messages": [
      {
        "content": [
          {
            "text": "Read the file notes.txt with the read_file tool and tell me its first line. Do not guess its contents.",
            "type": "text"
          }
        ],
        "role": "user"
      }
    ],
    "model": "claude-opus-4-6",
    "stream": true,
    "system": [
      {
        "text": "You are Claude Code, Anthropic's official CLI for Claude.",
        "type": "text"
      },
      {
        "cache_control": {
          "type": "ephemeral"
        },
        "text": "You are a terse assistant under test. When a tool fits the task, call it instead of answering in prose.",
        "type": "text"
      }
    ],
    "thinking": {
      "budget_tokens": 4000,
      "type": "enabled"
    },
    "tools": [
      {
        "description": "Read a UTF-8 text file and return its contents.",
        "input_schema": {
          "properties": {
            "path": {
              "description": "Path to the file, relative to the workspace.",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "name": "read_file"
      }
    ]
  }
}